<Window x:Class="PortableBulkFileRenamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portable Bulk File Renamer" Height="900" Width="1400"
        MinHeight="720" MinWidth="1080" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="4,2"/><Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="4,2"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="5,3"/><Setter Property="Margin" Value="4,2"/><Setter Property="MinHeight" Value="28"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="4,5"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="4,3,4,7"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <ComboBox x:Name="LanguageCombo" Width="130" DockPanel.Dock="Right" SelectedIndex="0" SelectionChanged="LanguageCombo_SelectionChanged">
                <ComboBoxItem Content="Tiếng Việt" Tag="vi"/><ComboBoxItem Content="English" Tag="en"/>
            </ComboBox>
            <TextBlock x:Name="AppTitle" Text="Portable Bulk File Renamer" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <GroupBox Grid.Row="1" x:Name="SourceGroup" Header="1. Nguồn file" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SourceText" Grid.Row="0" Grid.Column="0" IsReadOnly="True"/>
                <Button x:Name="ChooseFolderButton" Grid.Column="1" Content="Chọn thư mục" Click="ChooseFolder_Click"/>
                <Button x:Name="ChooseFilesButton" Grid.Column="2" Content="Chọn file" Click="ChooseFiles_Click"/>
                <Button x:Name="ClearButton" Grid.Column="3" Content="Xóa danh sách" Click="Clear_Click"/>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal">
                    <CheckBox x:Name="RecursiveCheck" Content="Bao gồm thư mục con" IsChecked="False" Checked="RecursiveCheck_Changed" Unchecked="RecursiveCheck_Changed"/>
                    <TextBlock x:Name="FilterLabel" Text="Lọc tên file:" VerticalAlignment="Center" Margin="18,0,0,0"/>
                    <TextBox x:Name="FilterBox" Width="280" TextChanged="FilterBox_TextChanged"/>
                    <Button x:Name="SelectAllButton" Content="Chọn tất cả" Click="SelectAll_Click"/>
                    <Button x:Name="DeselectAllButton" Content="Bỏ chọn" Click="DeselectAll_Click"/>
                    <Button x:Name="KeepSelectedButton" Content="Chỉ giữ file đã chọn" Click="KeepSelected_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" x:Name="RuleBuilderGroup" Header="2. Tạo quy tắc đổi tên" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="1.12*"/></Grid.ColumnDefinitions>

                <GroupBox Grid.Row="0" Grid.Column="0" x:Name="SearchGroup" Header="A. TÌM KIẾM — Xác định nội dung và vị trí" Margin="3" Padding="7" BorderBrush="#FF3994F5" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.65*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="SearchModeLabel" Grid.Row="0" Grid.Column="0" Text="Chế độ tìm kiếm" Margin="4"/>
                        <TextBlock x:Name="FindLabel" Grid.Row="0" Grid.Column="1" Text="Tìm cụm ký tự" Margin="4"/>
                        <TextBlock x:Name="PositionLabel" Grid.Row="0" Grid.Column="2" Text="Vị trí bắt đầu từ" Margin="4"/>
                        <TextBlock x:Name="PositionDirectionLabel" Grid.Row="0" Grid.Column="3" Text="Cách xác định vị trí" Margin="4"/>
                        <ComboBox x:Name="SearchModeCombo" Grid.Row="1" Grid.Column="0" SelectedIndex="0" SelectionChanged="SearchMode_Changed">
                            <ComboBoxItem Content="Bất kỳ vị trí nào" Tag="Anywhere"/><ComboBoxItem Content="Đầu tên file" Tag="Prefix"/><ComboBoxItem Content="Cuối tên file" Tag="Suffix"/><ComboBoxItem Content="Vị trí chính xác" Tag="ExactPosition"/>
                        </ComboBox>
                        <TextBox x:Name="FindBox" Grid.Row="1" Grid.Column="1"/>
                        <TextBox x:Name="PositionBox" Grid.Row="1" Grid.Column="2" Text="1"/>
                        <ComboBox x:Name="PositionDirectionCombo" Grid.Row="1" Grid.Column="3" SelectedIndex="0">
                            <ComboBoxItem Content="Khoảng cách từ đầu tên" Tag="Start"/><ComboBoxItem Content="Khoảng cách từ cuối tên" Tag="End"/>
                        </ComboBox>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal">
                            <CheckBox x:Name="CaseSensitiveCheck" Content="Phân biệt hoa/thường" IsChecked="False"/>
                            <CheckBox x:Name="AllOccurrencesCheck" Content="Thay/xóa tất cả kết quả" IsChecked="True"/>
                        </StackPanel>
                        <TextBlock x:Name="SearchHelpText" Grid.Row="3" Grid.ColumnSpan="4" Text="Ví dụ: tìm cụm PAU tại vị trí thứ 1, tính từ đầu tên file." Foreground="#FF607D9B" FontSize="11" Margin="4" TextWrapping="Wrap"/>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="0" Grid.Column="1" x:Name="ActionGroup" Header="B. THAO TÁC — Xử lý nội dung tìm được" Margin="3" Padding="7" BorderBrush="#FF22A06B" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ActionLabel" Grid.Row="0" Grid.Column="0" Text="Thao tác" Margin="4"/>
                        <TextBlock x:Name="ReplaceLabel" Grid.Row="0" Grid.Column="1" Text="Thay bằng" Margin="4"/>
                        <ComboBox x:Name="ActionCombo" Grid.Row="1" Grid.Column="0" SelectedIndex="0" SelectionChanged="Action_Changed">
                            <ComboBoxItem Content="Thay thế" Tag="Replace"/><ComboBoxItem Content="Xóa cụm ký tự" Tag="Remove"/><ComboBoxItem Content="Thêm tiền tố" Tag="AddPrefix"/><ComboBoxItem Content="Thêm hậu tố" Tag="AddSuffix"/><ComboBoxItem Content="Chuyển thành chữ hoa" Tag="Uppercase"/><ComboBoxItem Content="Chuyển thành chữ thường" Tag="Lowercase"/>
                        </ComboBox>
                        <TextBox x:Name="ReplaceBox" Grid.Row="1" Grid.Column="1"/>
                        <TextBlock x:Name="ActionHelpText" Grid.Row="2" Grid.ColumnSpan="2" Text="Các ô nhập liệu sẽ tự động bật/tắt theo thao tác được chọn." Foreground="#FF607D9B" FontSize="11" Margin="4,6,4,2" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ExtensionNote" Grid.Row="3" Grid.ColumnSpan="2" Text="Tìm kiếm trên tên file, không gồm phần mở rộng; phần mở rộng được giữ nguyên." Foreground="#FF4B647A" FontSize="11" Margin="4" TextWrapping="Wrap"/>
                    </Grid>
                </GroupBox>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,2">
                    <Button x:Name="AddRuleButton" Content="Thêm quy tắc" Click="AddRule_Click" Background="#FFDAEAF8"/>
                    <Button x:Name="RemoveRuleButton" Content="Xóa quy tắc đã chọn" Click="RemoveRule_Click"/>
                    <Button x:Name="MoveUpButton" Content="Lên ↑" Click="MoveRuleUp_Click"/>
                    <Button x:Name="MoveDownButton" Content="Xuống ↓" Click="MoveRuleDown_Click"/>
                    <Button x:Name="PreviewButton" Content="XEM TRƯỚC" Click="Preview_Click" Background="#FF1976D2" Foreground="White" BorderBrush="#FF125AA0" BorderThickness="2" FontWeight="Bold" FontSize="14" Padding="18,10" MinHeight="42"/>
                    <Button x:Name="RenameButton" Content="ĐỔI TÊN FILE ĐÃ CHỌN" Click="Rename_Click" Background="#FF218838" Foreground="White" BorderBrush="#FF145523" BorderThickness="2" FontWeight="Bold" FontSize="14" Padding="20,10" MinHeight="44"/>
                    <Button x:Name="UndoButton" Content="HOÀN TÁC" Click="Undo_Click" Background="#FFFFC107" Foreground="#FF212529" BorderBrush="#FFB8860B" BorderThickness="2" FontWeight="Bold" FontSize="14" Padding="18,10" MinHeight="42"/>
                </StackPanel>

                <GroupBox Grid.Row="2" Grid.ColumnSpan="2" x:Name="RulesListGroup" Header="3. Thứ tự quy tắc (chạy từ trên xuống)" Padding="5" Margin="0,4,0,0">
                    <DataGrid x:Name="RulesGrid" Height="105" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="RuleOrderColumn" Header="#" Binding="{Binding Order}" Width="45"/>
                            <DataGridTextColumn x:Name="RuleSearchColumn" Header="Chế độ tìm kiếm" Binding="{Binding SearchModeLabel}" Width="1.2*"/>
                            <DataGridTextColumn x:Name="RuleActionColumn" Header="Thao tác" Binding="{Binding ActionLabel}" Width="1.2*"/>
                            <DataGridTextColumn x:Name="RuleFindColumn" Header="Tìm" Binding="{Binding Find}" Width="*"/>
                            <DataGridTextColumn x:Name="RuleReplaceColumn" Header="Thay bằng / Nội dung thêm" Binding="{Binding Replace}" Width="*"/>
                            <DataGridTextColumn x:Name="RulePositionColumn" Header="Vị trí" Binding="{Binding PositionDescription}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="3" x:Name="PreviewGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow" PreviewKeyDown="PreviewGrid_PreviewKeyDown" AlternatingRowBackground="#FFF4F7FA" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="IncludeColumn" Header="Đổi tên" Width="65">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" PreviewMouseLeftButtonDown="IncludeCheckBox_PreviewMouseLeftButtonDown"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="StatusColumn" Header="Trạng thái" Binding="{Binding Status}" Width="145"/>
                <DataGridTextColumn x:Name="OldColumn" Header="Tên hiện tại" Binding="{Binding OldName}" Width="1.5*"/>
                <DataGridTextColumn x:Name="NewColumn" Header="Tên mới dự kiến" Binding="{Binding NewName}" Width="1.5*"/>
                <DataGridTextColumn x:Name="FolderColumn" Header="Thư mục" Binding="{Binding Folder}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock x:Name="PrivacyText" Text="Chạy cục bộ; không gửi file hoặc tên file ra ngoài." VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Text="0 file" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
