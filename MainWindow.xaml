<Window x:Class="PortableBulkFileRenamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portable Bulk File Renamer" Height="790" Width="1250"
        MinHeight="650" MinWidth="980" WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <TextBlock x:Name="LanguageLabel" Text="Ngôn ngữ / Language:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox x:Name="LanguageCombo" Width="115" SelectedIndex="0" SelectionChanged="LanguageCombo_SelectionChanged">
                    <ComboBoxItem Content="Tiếng Việt" Tag="vi"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                </ComboBox>
            </StackPanel>
            <TextBlock x:Name="AppTitle" Text="Portable Bulk File Renamer" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <GroupBox Grid.Row="1" x:Name="SourceGroup" Header="Nguồn file / File source" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" Grid.Column="0" IsReadOnly="True" VerticalContentAlignment="Center"/>
                <Button x:Name="ChooseFolderButton" Grid.Column="1" Content="Chọn thư mục..." Click="ChooseFolder_Click"/>
                <Button x:Name="ChooseFilesButton" Grid.Column="2" Content="Chọn file..." Click="ChooseFiles_Click"/>
                <Button x:Name="ClearButton" Grid.Column="3" Content="Xóa danh sách" Click="Clear_Click"/>
                <CheckBox x:Name="RecursiveCheck" Grid.Row="1" Content="Bao gồm thư mục con / Include subfolders" IsChecked="True"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" x:Name="RulesGroup" Header="Quy tắc đổi tên / Rename rules" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="PrefixLabel" Grid.Row="0" Grid.Column="0" Text="Tiền tố / Prefix" Margin="4"/>
                <TextBlock x:Name="FindLabel" Grid.Row="0" Grid.Column="1" Text="Tìm / Find" Margin="4"/>
                <TextBlock x:Name="ReplaceLabel" Grid.Row="0" Grid.Column="2" Text="Thay bằng / Replace" Margin="4"/>
                <TextBlock x:Name="SuffixLabel" Grid.Row="0" Grid.Column="3" Text="Hậu tố / Suffix" Margin="4"/>
                <TextBlock x:Name="RemoveLabel" Grid.Row="0" Grid.Column="4" Text="Xóa cụm từ / Remove" Margin="4"/>
                <TextBox x:Name="PrefixBox" Grid.Row="1" Grid.Column="0"/>
                <TextBox x:Name="FindBox" Grid.Row="1" Grid.Column="1"/>
                <TextBox x:Name="ReplaceBox" Grid.Row="1" Grid.Column="2"/>
                <TextBox x:Name="SuffixBox" Grid.Row="1" Grid.Column="3"/>
                <TextBox x:Name="RemoveBox" Grid.Row="1" Grid.Column="4"/>
                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="5" VerticalAlignment="Center">
                    <CheckBox x:Name="NumberCheck" Content="Đánh số / Number" IsChecked="False" Checked="NumberCheck_Changed" Unchecked="NumberCheck_Changed"/>
                    <StackPanel x:Name="NumberOptions" Orientation="Horizontal">
                        <TextBlock x:Name="StartLabel" Text="Bắt đầu" VerticalAlignment="Center"/>
                        <TextBox x:Name="NumberStartBox" Text="1" Width="48"/>
                        <TextBlock x:Name="DigitsLabel" Text="Số chữ số" VerticalAlignment="Center"/>
                        <TextBox x:Name="DigitsBox" Text="3" Width="42"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,5,0,0">
                    <CheckBox x:Name="CaseSensitiveCheck" Content="Phân biệt hoa/thường khi tìm / Case-sensitive find" IsChecked="False"/>
                    <CheckBox x:Name="KeepExtensionCheck" Content="Giữ nguyên phần mở rộng / Keep extension" IsChecked="True"/>
                    <Button x:Name="PreviewButton" Content="Xem trước / Preview" Click="Preview_Click" Background="#FFDAEAF8"/>
                    <Button x:Name="RenameButton" Content="Đổi tên / Rename" Click="Rename_Click" Background="#FFD9F2D9"/>
                    <Button x:Name="UndoButton" Content="Hoàn tác / Undo" Click="Undo_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="3" x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
                  AlternatingRowBackground="#FFF4F7FA" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="StatusColumn" Header="Trạng thái / Status" Binding="{Binding Status}" Width="140"/>
                <DataGridTextColumn x:Name="OldColumn" Header="Tên hiện tại / Current name" Binding="{Binding OldName}" Width="2*"/>
                <DataGridTextColumn x:Name="NewColumn" Header="Tên mới / New name" Binding="{Binding NewName}" Width="2*"/>
                <DataGridTextColumn x:Name="FolderColumn" Header="Thư mục / Folder" Binding="{Binding Folder}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock x:Name="PrivacyText" Text="Chạy cục bộ; không gửi file hoặc tên file ra ngoài." VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Text="0 file" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
